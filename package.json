{
  "name": "Rel3c",
  "version": "0.1.0",
  "description": "Deterministic reactive frontend framework built from scratch in vanilla JavaScript",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "docs:prepare": "node scripts/prepare-docs.js",
    "docs:check": "node scripts/check-docs-site.js",
    "test": "node scripts/test-node.js tests",
    "test:browser": "node scripts/check-app-lifecycle.js",
    "test:spikes": "node scripts/test-node.js spikes",
    "bench:spikes": "node scripts/bench-spikes.js",
    "bench:runtime": "node scripts/bench-runtime.js",
    "bench:spikes:browser": "node scripts/bench-spikes-browser.js",
    "test:benchmarks": "node scripts/test-node.js benchmarks",
    "check:view-syntax": "node scripts/check-view-syntax.js",
    "test:types": "node scripts/check-action-types.js",
    "smoke": "node scripts/smoke.js",
    "audit:frontend": "node scripts/audit-frontend.js",
    "bench:tooling:node": "node scripts/bench-tooling-node.js",
    "bench:tooling:browser": "node scripts/bench-tooling-browser.js"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "keywords": [
    "framework",
    "reactive",
    "deterministic",
    "vanilla-js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
