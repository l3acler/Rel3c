  "consumerSource": "import assert from 'node:assert/strict';\nimport * as framework from 'mini-framework';\nconst {createApp,createActionSchema,createReplay,createDiagnostics,hashSnapshot}=framework;\nconst schema=createActionSchema({version:'package-review/1'})(({action})=>({\n  add:action((draft,services)=>{draft.count++;draft.draw=services.random();}),\n  fail:action(draft=>{draft.count=999;throw Error('rollback');}),\n}));\nconst app=createApp({schema,initialState:{count:0,draw:0},controls:{seed:123}});\nconst diagnostics=createDiagnostics(app,{maxEntries:8,maxBytes:65536});\napp.startRecording({mode:'session',maxActions:16,maxBytes:1048576});\napp.actions.add();app.actions.add();\nconst before=app.snapshot();assert.throws(()=>app.actions.fail(),/rollback/);assert.equal(app.snapshot(),before);\nconst recording=app.exportRecording(),replay=createReplay({recording,schema});\nassert.equal(replay.run().status,'complete');assert.equal(hashSnapshot(replay.app.snapshot()),hashSnapshot(app.snapshot()));\nassert.equal(app.state.count,2);assert.equal(app.stateVersion,3);assert.ok(Object.isFrozen(app.state));\nconst names=Object.keys(framework).sort();replay.dispose();app.dispose();assert.equal(diagnostics.snapshot().status,'disposed');\nconsole.log(JSON.stringify({passed:true,exports:names,version:framework.VERSION,hash:hashSnapshot(before),checks:['package-name import','action/seeded-services','rollback','recording/replay endpoint','readonly ownership','diagnostic/replay/app disposal']}));\n",
